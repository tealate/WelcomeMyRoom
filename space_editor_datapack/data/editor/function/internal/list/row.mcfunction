$tellraw @s [{text:"#$(id) $(type) ",color:"gold"},{nbt:"list[0].label",storage:"editor:runtime"},{text:" [選択]",color:"aqua",click_event:{action:"run_command",command:"/function editor:objects/select {id:$(id)}"}},{text:" [更新]",color:"green",click_event:{action:"suggest_command",command:"/function editor:objects/update {id:$(id)}"}},{text:" [削除]",color:"red",click_event:{action:"suggest_command",command:"/function editor:objects/delete {id:$(id)}"}},{text:" [名前]",color:"gray",click_event:{action:"suggest_command",command:'/function editor:objects/rename {id:$(id),label:"name"}'}}]
data modify storage editor:runtime list_item set from storage editor:runtime list[0]
$execute if data storage editor:runtime list_item{type:"teleport_volume"} run tellraw @s [{text:"  [現在地をTP先に設定]",color:"yellow",click_event:{action:"suggest_command",command:"/function editor:teleport/link {id:$(id)}"}}]
