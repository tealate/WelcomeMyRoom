$execute in $(dimension) if data storage space_editor:document regions[{id:$(id),kind:"teleport"}] as @e[type=minecraft:block_display,tag=space_editor.region,scores={se.id=$(id)}] run data merge entity @s {block_state:{Name:"minecraft:magenta_glazed_terracotta",Properties:{facing:"east"}}}
$execute in $(dimension) if data storage space_editor:document regions[{id:$(id),kind:"space_link"}] as @e[type=minecraft:block_display,tag=space_editor.region,scores={se.id=$(id)}] run data merge entity @s {block_state:{Name:"minecraft:magenta_glazed_terracotta",Properties:{facing:"south"}}}
$execute in $(dimension) if data storage space_editor:document regions[{id:$(id),kind:"proxy_existence"}] as @e[type=minecraft:block_display,tag=space_editor.region,scores={se.id=$(id)}] run data merge entity @s {block_state:{Name:"minecraft:magenta_glazed_terracotta",Properties:{facing:"west"}}}
$execute in $(dimension) if data storage space_editor:document regions[{id:$(id),kind:"search_area"}] as @e[type=minecraft:block_display,tag=space_editor.region,scores={se.id=$(id)}] run data merge entity @s {block_state:{Name:"minecraft:lime_glazed_terracotta",Properties:{facing:"east"}},width:1024f,height:1024f,view_range:16f}
